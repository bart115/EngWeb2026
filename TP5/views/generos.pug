extends layout

block content
  .w3-card-4
    header.w3-container.w3-black
      h1 
        span.w3-serif Lista de Generos  
        a.w3-button.w3-border.w3-border-white.w3-margin-left.w3-small.w3-round(href='/') Filmes  
        a.w3-button.w3-border.w3-border-white.w3-margin-left.w3-small.w3-round(href='/atores') Atores
        a.w3-button.w3-border.w3-border-blue.w3-margin-left.w3-small.w3-round(href='/generos') Generos
        
    .w3-container
      table.w3-table-all.w3-margin-top
        thead
          tr
          if aux == 0
            th.w3-hover-grey(style="cursor:pointer" onclick=`window.location.href='/generos?_sort=id&_order=desc'`) ID ⮝ 
            th.w3-hover-grey(style="cursor:pointer" onclick=`window.location.href='/generos?_sort=name&_order=asc'`) Genero ⮟
            th #Filmes
          if aux == 1
            th.w3-hover-grey(style="cursor:pointer" onclick=`window.location.href='/generos?_sort=id&_order=asc'`) ID  ⮟
            th.w3-hover-grey(style="cursor:pointer" onclick=`window.location.href='/generos?_sort=name&_order=asc'`) Genero ⮟
            th #Filmes
          if aux == 2
            th.w3-hover-grey(style="cursor:pointer" onclick=`window.location.href='/generos?_sort=id&_order=asc'`) ID ⮟ 
            th.w3-hover-grey(style="cursor:pointer" onclick=`window.location.href='/generos?_sort=name&_order=desc'`) Genero ⮝
            th #Filmes
          if aux == 3
            th.w3-hover-grey(style="cursor:pointer" onclick=`window.location.href='/generos?_sort=id&_order=asc'`) ID ⮟
            th.w3-hover-grey(style="cursor:pointer" onclick=`window.location.href='/generos?_sort=name&_order=asc'`) Genero ⮟
            th #Filmes
        tbody
          each t in generos
            tr.w3-hover-grey(style="cursor:pointer" onclick=`window.location.href='/generos/${t.id}'`)
              td= t.id
              td= t.name
              td= t.filmes.length