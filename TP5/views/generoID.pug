extends layout

block content
  .w3-card-4
    header.w3-container.w3-black 
      h1 #{genero.name}

    .w3-container
      table.w3-table-all.w3-margin-top
        tr
          th ID
          td= genero.id
        tr
          th Genero
          td= genero.name
        tr
          th Filmes
          td
            each f in genero.filmes
              a.w3-hover(href='/filmes/' + f.id) #{f.title}
              br
      a.w3-button.w3-teal.w3-margin-top(href='/generos') Voltar
