extends layout

block content
  .w3-card-4
    header.w3-container.w3-black
      h1
        span.w3-serif Lista de Filmes  
        
        a.w3-button.w3-border.w3-border-blue.w3-margin-left.w3-small.w3-round(href='/') Filmes
        a.w3-button.w3-border.w3-border-white.w3-margin-left.w3-small.w3-round(href='/atores') Atores 
        a.w3-button.w3-border.w3-border-white.w3-margin-left.w3-small.w3-round(href='/generos') Generos
        
    .w3-container
      table.w3-table-all.w3-margin-top
        thead
          tr
          if aux == 0
            th.w3-hover-grey(style="cursor:pointer" onclick=`window.location.href='/?_sort=id&_order=desc'`) ID ⮝ 
            th.w3-hover-grey(style="cursor:pointer" onclick=`window.location.href='/?_sort=title&_order=asc'`) Título ⮟
            th Ano 
            th #Gênero
            th #Cast
          if aux == 1
            th.w3-hover-grey(style="cursor:pointer" onclick=`window.location.href='/?_sort=id&_order=asc'`) ID  ⮟
            th.w3-hover-grey(style="cursor:pointer" onclick=`window.location.href='/?_sort=title&_order=asc'`) Título ⮟
            th Ano
            th Género
            th Cast
          if aux == 2
            th.w3-hover-grey(style="cursor:pointer" onclick=`window.location.href='/?_sort=id&_order=asc'`) ID ⮟ 
            th.w3-hover-grey(style="cursor:pointer" onclick=`window.location.href='/?_sort=title&_order=desc'`) Título ⮝
            th Ano
            th Género
            th Cast
          if aux == 3
            th.w3-hover-grey(style="cursor:pointer" onclick=`window.location.href='/?_sort=id&_order=asc'`) ID ⮟
            th.w3-hover-grey(style="cursor:pointer" onclick=`window.location.href='/?_sort=title&_order=asc'`) Título ⮟
            th Ano
            th Género
            th Cast
        tbody
          each t in list
            tr.w3-hover-grey(style="cursor:pointer" onclick=`window.location.href='/filmes/${t.id}'`)
              td= t.id
              td= t.title
              td= t.year
              td= t.genres.length
              td= t.cast.length
              